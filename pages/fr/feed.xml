---
layout: null
permalink: /fr/feed.xml
sitemap: false
---
{%- comment -%}
  French Atom feed. jekyll-feed can't filter by language, so this one is hand-written
  and mirrors the main /feed.xml (excerpts only, same entry format).
{%- endcomment -%}
{%- assign fr_posts = site.posts | where: "lang", "fr" -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="fr">
  <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>
  <link href="{{ page.url | absolute_url }}" rel="self" type="application/atom+xml" />
  <link href="{{ '/fr/' | absolute_url }}" rel="alternate" type="text/html" hreflang="fr" />
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ page.url | absolute_url | xml_escape }}</id>
  <title type="html">{{ site.title | xml_escape }} (français)</title>
  <subtitle>Rémi Mercier – Développeur Ruby on Rails freelance</subtitle>
  <author><name>{{ site.author | xml_escape }}</name></author>
  {%- for post in fr_posts limit: 100 %}
  <entry xml:lang="fr">
    <title type="html">{{ post.title | smartify | strip_html | normalize_whitespace | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html" title="{{ post.title | xml_escape }}" />
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    <id>{{ post.id | absolute_url | xml_escape }}</id>
    <author><name>{{ site.author | xml_escape }}</name></author>
    {%- for tag in post.tags %}
    <category term="{{ tag | xml_escape }}" />
    {%- endfor %}
    {%- assign excerpt = post.excerpt | strip_html | normalize_whitespace -%}
    {%- if excerpt != "" %}
    <summary type="html"><![CDATA[{{ excerpt }}]]></summary>
    {%- endif %}
  </entry>
  {%- endfor %}
</feed>
